  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000,
  },
  "plugin": [
    "opencode-working-memory",
    [
      "@tokenwarden/opencode",
      {
        "maxToolOutputTokens": 5000,
        "maxContextPartTokens": 5000,
      },
    ],
    "opentmux",
    "opencode-agent-tmux"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".next/**",
      "coverage/**",
      "*.lock",
    ],
  },
  "permission": {
    "bash": "allow",
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/secrets/**": "deny",
      "**/credentials*": "deny",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/secrets/**": "deny",
      "**/credentials*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa*": "deny",
      "**/.ssh/**": "deny",
      "**/service-account*.json": "deny",
      "**/*.cred": "deny",
    },
    "grep": "allow",
    "question": "allow",
    "glob": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
